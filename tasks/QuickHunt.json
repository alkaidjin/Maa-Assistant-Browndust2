{
    "task": [
        {
            "name": "QuickHunt",
            "label": "日常-快速狩猎",
            "entry": "StartGame",
            "description": "圣石部分：按选项刷指定属性（或自动挑数量最少的）。米饭部分由三个必选二选一决定：\n①米饭使用策略＝全刷金币/史莱姆（不看加成）｜有加成时刷金币/史莱姆、无加成时刷装备材料；\n②刷哪个副本＝金币（哥布林遗迹）｜史莱姆（史莱姆王国）；\n③材料副本＝第 7 章矿石（蜥锡人祭坛）｜第 9 章原木（守山人休息处）。\n由原「一条龙日常」按任务类型拆出，可与其余四个日常任务独立勾选、互不连坐。",
            "controller": [
                "Win32",
                "Win32-Window",
                "Win32-Front"
            ],
            "option": [
                "ChooseRock",
                "ChooseHuntStrategy",
                "ChooseHuntTarget",
                "ChooseWood"
            ],
            "pipeline_override": {
                "EnterGame_2": {
                    "next": [
                        "StartHunt",
                        "DailyAllEnd"
                    ]
                },
                "StartHunt": {
                    "max_hit": 1
                },
                "快速狩猎完成": {
                    "focus": {
                        "Node.Action.Starting": {
                            "content": "【完成】快速狩猎",
                            "display": ["log"]
                        }
                    }
                }
            }
        }
    ],
    "option": {
        "ChooseRock": {
            "type": "select",
            "label": "快速狩猎—刷取的圣石属性",
            "default_case": "AutoLeastRock",
            "cases": [
                {
                    "name": "FireRock",
                    "label": "火之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "FireRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "WaterRock",
                    "label": "水之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "WaterRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "WindRock",
                    "label": "风之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "WindRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "LightRock",
                    "label": "光之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "LightRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "DarkRock",
                    "label": "暗之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "DarkRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "AutoLeastRock",
                    "label": "自动：刷数量最少的圣石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": ["PickLeastRock"],
                            "timeout": 8000
                        }
                    }
                }
            ],
            "description": "刷哪种属性的圣石。选「自动：刷数量最少的圣石」会读 5 个圣石数量，挑最少的那个刷。"
        },
        "ChooseHuntStrategy": {
            "type": "select",
            "label": "快速狩猎—米饭使用策略（二选一）",
            "description": "决定当天米饭怎么花：要么无论有没有双倍加成都刷金币/史莱姆；要么只在有双倍加成时刷，没加成时改刷下面选的装备材料副本。",
            "default_case": "BuffOrMaterial",
            "cases": [
                {
                    "name": "FarmAll",
                    "label": "全刷金币/史莱姆（不看有没有加成）",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["HuntAll"]
                        }
                    }
                },
                {
                    "name": "BuffOrMaterial",
                    "label": "有加成时刷金币/史莱姆，无加成时刷装备材料",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["HuntOnBuff"]
                        }
                    }
                }
            ]
        },
        "ChooseHuntTarget": {
            "type": "select",
            "label": "快速狩猎—刷金币或史莱姆（二选一）",
            "description": "米饭要刷的那类副本：金币关或史莱姆关。策略选「有加成时刷」时，这一项同时决定「判断哪个副本的双倍加成」。",
            "default_case": "HuntGold",
            "cases": [
                {
                    "name": "HuntGold",
                    "label": "刷金币（哥布林遗迹）",
                    "pipeline_override": {
                        "HuntAll": {
                            "next": ["AllGold"]
                        },
                        "HuntOnBuff": {
                            "next": ["YESorNOGoldUP"]
                        }
                    }
                },
                {
                    "name": "HuntSlime",
                    "label": "刷史莱姆（史莱姆王国）",
                    "pipeline_override": {
                        "HuntAll": {
                            "next": ["AllSlime"]
                        },
                        "HuntOnBuff": {
                            "next": ["YESorNOSlimeUP"]
                        }
                    }
                }
            ]
        },
        "ChooseWood": {
            "type": "select",
            "label": "快速狩猎—材料副本（二选一）",
            "description": "策略选「有加成时刷…无加成时刷装备材料」时，无加成的部分去哪个材料副本。",
            "default_case": "OreHunt",
            "cases": [
                {
                    "name": "OreHunt",
                    "label": "刷第七章矿石（蜥锡人祭坛）",
                    "pipeline_override": {
                        "WoodOrOre": {
                            "next": ["OreHunt"]
                        }
                    }
                },
                {
                    "name": "WoodHunt",
                    "label": "刷第九章原木（守山人休息处）",
                    "pipeline_override": {
                        "WoodOrOre": {
                            "next": ["WoodHunt"]
                        }
                    }
                }
            ]
        }
    }
}

{
    "task": [
        {
            "name": "QuickHunt",
            "label": "日常-快速狩猎",
            "entry": "StartGame",
            "description": "按选项刷取：指定属性的圣石（或自动挑数量最少的）、指定刷图策略（史莱姆/金币/装备材料）、装备材料种类（第9章原木/第7章矿石）。\n由原「一条龙日常」按任务类型拆出，可与其余四个日常任务独立勾选、互不连坐。",
            "controller": [
                "Win32",
                "Win32-Window",
                "Win32-Front"
            ],
            "option": [
                "ChooseRock",
                "ChooseHuntStrategy",
                "ChooseWood"
            ],
            "pipeline_override": {
                "EnterGame_2": {
                    "next": [
                        "StartHunt",
                        "DailyAllEnd"
                    ]
                },
                "StartHunt": {
                    "max_hit": 1
                },
                "快速狩猎完成": {
                    "focus": {
                        "Node.Action.Starting": {
                            "content": "【完成】快速狩猎",
                            "display": ["log"]
                        }
                    }
                }
            }
        }
    ],
    "option": {
        "ChooseRock": {
            "type": "select",
            "label": "快速狩猎—刷取的圣石属性",
            "default_case": "AutoLeastRock",
            "cases": [
                {
                    "name": "FireRock",
                    "label": "火之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "FireRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "WaterRock",
                    "label": "水之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "WaterRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "WindRock",
                    "label": "风之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "WindRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "LightRock",
                    "label": "光之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "LightRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "DarkRock",
                    "label": "暗之石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": [
                                "DarkRock",
                                "GetRock"
                            ]
                        }
                    }
                },
                {
                    "name": "AutoLeastRock",
                    "label": "自动：刷数量最少的圣石",
                    "pipeline_override": {
                        "GetRock": {
                            "next": ["PickLeastRock"],
                            "timeout": 8000
                        }
                    }
                }
            ],
            "description": "刷哪种属性的圣石。选「自动：刷数量最少的圣石」会读 5 个圣石数量，挑最少的那个刷。"
        },
        "ChooseHuntStrategy": {
            "type": "select",
            "label": "快速狩猎—刷图策略",
            "default_case": "GoldOnly",
            "cases": [
                {
                    "name": "SlimeOnBuff",
                    "label": "刷取史莱姆（仅在有加成时）",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["YESorNOSlimeUP"]
                        }
                    }
                },
                {
                    "name": "GoldOnBuff",
                    "label": "刷取金币（仅在有加成时）",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["YESorNOGoldUP"]
                        }
                    }
                },
                {
                    "name": "GoldOnly",
                    "label": "只刷金币",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["AllGold"]
                        }
                    }
                },
                {
                    "name": "MaterialOnly",
                    "label": "只刷装备材料",
                    "pipeline_override": {
                        "ChooseWorO_Swipe": {
                            "next": ["WoodOrOre"]
                        }
                    }
                }
            ],
            "description": "刷图策略：刷史莱姆/刷金币只在当日有加成时才刷；也可只刷金币或只刷装备材料。"
        },
        "ChooseWood": {
            "type": "select",
            "label": "快速狩猎—装备材料刷取种类",
            "default_case": "WoodHunt",
            "cases": [
                {
                    "name": "WoodHunt",
                    "label": "第九章原木",
                    "pipeline_override": {
                        "WoodOrOre": {
                            "next": ["WoodHunt"]
                        }
                    }
                },
                {
                    "name": "OreHunt",
                    "label": "第七章矿石",
                    "pipeline_override": {
                        "WoodOrOre": {
                            "next": ["OreHunt"]
                        }
                    }
                }
            ],
            "description": "只刷装备材料时用哪种：第 9 章原木 / 第 7 章矿石。"
        }
    }
}

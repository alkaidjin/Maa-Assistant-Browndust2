{
    "task": [
        {
            "name": "自动钓鱼（测试版）",
            "label": "自动钓鱼（测试版）",
            "entry": "AutoFishing_Start",
            "description": "请在游戏主界面或码头界面开始任务! \n请尽量使用大师之作、命运之丝和泰坦征服者这类弱点命中判定区域扩大数值高的钓鱼竿，以增加弱点判定命中率!\n脚本调试用鱼竿为黑曜之楔",
            "option": [
                "FishingSpot",
                "FishingCount"
            ]
        }
    ],
    "option": {
        "FishingSpot": {
            "type": "select",
            "label": "选择钓鱼地区",
            "des": "选择钓鱼地区",
            "default_case": "Lake",
            "cases": [
                {
                    "name": "Lake",
                    "label": "烟波湖",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "Fishing_MistyLake"
                            ]
                        }
                    }
                },
                {
                    "name": "Shallow",
                    "label": "浅岸",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "Fishing_ShallowCoastalWaters"
                            ]
                        }
                    }
                },
                {
                    "name": "Frost",
                    "label": "寒霜海峡",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "AutoFish_EnterSpot_Frost"
                            ]
                        }
                    }
                },
                {
                    "name": "Atlantis",
                    "label": "亚特兰蒂斯",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "Fishing_Atlantis"
                            ]
                        }
                    }
                },
                {
                    "name": "AbyssalMaw",
                    "label": "深渊巨口",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "Fishing_AbyssalMaw_Swipe"
                            ]
                        }
                    }
                },
                {
                    "name": "SkyIsland",
                    "label": "天空岛",
                    "pipeline_override": {
                        "Fishing_MapChoose": {
                            "next": [
                                "Fishing_SkyIsland_Swipe"
                            ]
                        }
                    }
                }
            ]
        },
        "FishingCount": {
            "type": "select",
            "label": "钓鱼次数",

{
    "task": [
        {"name": "狩猎场",
            "label": "快速狩猎",
            "entry": "StartHunt",
            "description": "按自选刷取策略消耗每日免费米饭和每日免费火把",
            "option":["ChooseRock","ChooseDouble","ChooseWood","ChooseSlime"]
         }
             ],
    "option": {
        "ChooseRock":{
            "type":"select",
            "label":"刷取的圣石属性",
            "des":"",
            "default_case":"FireRock",
            "cases":[
                {
                    "name":"FireRock",
                    "label":"火之石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["FireRock",
                                "GetRock"]}}},
                {
                    "name":"WaterRock",
                    "label":"水之石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["WaterRock",
                                "GetRock"]}}},
                {
                    "name":"WindRock",
                    "label":"风之石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["WindRock",
                                "GetRock"]}}},
                {
                    "name":"LightRock",
                    "label":"光之石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["LightRock",
                                "GetRock"]}}},
                {
                    "name":"DarkRock",
                    "label":"暗之石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["DarkRock",
                                "GetRock"]}}},
                {
                    "name":"AutoLeastRock",
                    "label":"自动：刷数量最少的圣石",
                    "pipeline_override":{
                        "GetRock":{
                            "next":["PickLeastRock"],
                            "timeout":8000}}}
                    ]
                     },
        "ChooseWood":{
            "type":"select",
            "label":"刷第7章矿石亦或是第9章原木",
            "des":"",
            "default_case":"WoodHunt",
            "cases":[
                {
                    "name":"WoodHunt",
                    "label":"第九章原木",
                    "pipeline_override":{
                        "ChooseWorO_Swipe":{
                            "next":["WoodHunt"]}}},
                {
                    "name":"OreHunt",
                    "label":"第七章矿石",
                    "pipeline_override":{
                        "ChooseWorO_Swipe":{
                            "next":["OreHunt"]}}}
                    ]
                     },
        "ChooseSlime":{
            "type":"select",
            "label":"是否米饭全刷材料",
            "des":"",
            "default_case":"Once",
            "cases":[
                {
                    "name":"Once",
                    "label":"米饭只刷一次装备材料",
                    "pipeline_override":{
                        "FastHunt1":{
                            "next":["MainHunt1_Once"]}}},
                {
                    "name":"Max",
                    "label":"米饭全刷装备材料",
                    "pipeline_override":{
                        "FastHunt1":{
                            "next":["MainHunt1_Max"]}}},
                {
                    "name":"YESorNOGoldUP",
                    "label":"米饭刷加成金币本，无加成时全刷材料",
                    "pipeline_override":{
                        "FastHunt1":{
                            "next":["YESorNOGoldUP"]}}}
                    ]
                     },
         "ChooseDouble":{
            "type":"select",
            "label":"是否刷史莱姆",
            "des":"",
            "default_case":"AllGold",
            "cases":[
                {
                    "name":"Double",
                    "label":"掉落提升时刷史莱姆",
                    "pipeline_override":{
                        "ChooseGorS":{
                            "next":["SlimeHunt","GoldHunt"]}}},
                {
                    "name":"AllGold",
                    "label":"不刷史莱姆",
                    "pipeline_override":{
                        "ChooseGorS":{
                            "next":["AllGold"]}}}
                    ]
                     }
         }
}
            ],
            "pipeline_override": {
                "EnterGame_2": {
                    "next": [
                        "StartPVP",
                        "DailyAllEnd"
                    ]
                },
                "StartPVP": {
                    "max_hit": 1
                },
                "WaitForPVP": {
                    "focus": {
                        "Node.Action.Starting": {
                            "content": "【战斗进行中】镜中之战",
                            "display": ["log"]
                        }
                    }
                }
            }
        }
    ],
    "option": {

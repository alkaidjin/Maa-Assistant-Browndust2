                {
                    "name": "1倍",
                    "label": "1倍",
                    "pipeline_override": {
                        "消耗MIN": {
                            "next": ["1倍"]
                        }
                    }
                },
                {
                    "name": "10倍",
                    "label": "10倍",
                    "pipeline_override": {
                        "消耗MIN": {
                            "next": ["10倍"]
                        }
                    }
                },
                {
                    "name": "40倍",

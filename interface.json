{
    "interface_version": 2,
    "name": "MaaBrownDust2",
    "description": "MaaBrownDust2",
    "version": "v26.09.13",
    "license": "misc/LICENSE_SHORT.md",
    "welcome": "README.md",
    "icon": "misc/MaaEnd-Tiny.png",
    "github": "https://github.com/alkaidjin/Maa-Assistant-Browndust2",
    "mirrorchyan_rid": "Maa-Assistant-Browndust2",
    "mirrorchyan_multiplatform": true,
    "languages": {
        "zh_cn": "misc/locales/zh_cn.json"
    },
    "controller": [
        {
            "name": "Win32",
            "label": "$controller.Win32.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "FramePool",
                "screencap_target_short_side": 720,
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "Win32-Window",
            "label": "$controller.Win32-Window.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "Win32-Front",
            "label": "$controller.Win32-Front.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "DXGI_DesktopDup_Window",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "permission_required": true
        },
        {
            "name": "PlayCover",
            "type": "PlayCover",
            "playcover": {
                "uuid": "maa.playcover"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "$resource.CN.label",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": [
        {
            "child_exec": "agent/go-service",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust",
            "auto_reconnect": true
        },
        {
            "child_exec": "agent/rock-picker",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust_rock",
            "auto_reconnect": true
        },
        {
            "child_exec": "agent/fishing",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust_fishing",
            "auto_reconnect": true
        },
        {
            "child_exec": "agent/trader",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust_trader",
            "auto_reconnect": true
        }
    ],
    "task": [],
    "import": [
        "tasks/DailyAll.json",
        "tasks/RewardRoutine.json",
        "tasks/EvilCastle.json",
        "tasks/WarcraftShop.json",
        "tasks/AbsorpAssemble.json",
        "tasks/AbsorpAssembleRound2.json",
        "tasks/AutoFishing.json",
        "tasks/MapTrade.json",
        "tasks/WeeklyTasks.json",
        "tasks/pretasks/LaunchGame.json"
    ]
}

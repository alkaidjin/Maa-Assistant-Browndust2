{
    "interface_version": 2,
    "name": "MaaBrownDust2",
    "description": "MaaBrownDust2",
    "version": "v26.09.11",
    "license": "misc/LICENSE_SHORT.md",
    "welcome": "README.md",
    "icon": "misc/MaaEnd-Tiny.png",
    "github": "https://github.com/alkaidjin/Maa-Assistant-Browndust2",
    "mirrorchyan_rid": "Maa-Assistant-Browndust2",
    "mirrorchyan_multiplatform": true,
    "languages": {
        "zh_cn": "misc/locales/zh_cn.json",
        "zh_tw": "misc/locales/zh_tw.json",
        "en_us": "misc/locales/en_us.json",
        "ja_jp": "misc/locales/ja_jp.json",
        "ko_kr": "misc/locales/ko_kr.json"
    },
    "controller": [
        {
            "name": "Win32",
            "label": "$controller.Win32.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "FramePool",
                "screencap_target_short_side": 720,
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "Win32-Window",
            "label": "$controller.Win32-Window.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "Win32-Front",
            "label": "$controller.Win32-Front.label",
            "type": "Win32",
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "BrownDust II",
                "screencap": "DXGI_DesktopDup_Window",
                "mouse": "Seize",
                "keyboard": "Seize"
            },
            "permission_required": true
        },
        {
            "name": "PlayCover",
            "type": "PlayCover",
            "playcover": {
                "uuid": "maa.playcover"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "$resource.CN.label",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": [
        {
            "child_exec": "agent/go-service",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust",
            "auto_reconnect": true
        },
        {
            "child_exec": "agent/rock-picker",
            "child_args": [],
            "timeout": 15000,
            "identifier": "mxu_browndust_rock",
            "auto_reconnect": true
        }
    ],
    "task": [],
    "import": [
        "tasks/StartGame.json",
        "tasks/Draw.json",
        "tasks/DailyRoutine.json",
        "tasks/PVP.json",
        "tasks/HuntingArea.json",
        "tasks/Bag.json",
        "tasks/Warcraft.json",
        "tasks/WarcraftRerunQuickBattle.json",
        "tasks/EvilCastle.json",
        "tasks/RewardRoutine.json",
        "tasks/WarcraftShop.json",
        "tasks/AbsorpAssemble.json",
        "tasks/AbsorpAssembleRound2.json"
    ],
    "x_launch": {
        "launcher": "launcher.bat",
        "auto_update": "软件启动时通过 launcher.bat 检测 GitHub 新版本并弹窗提示（20 秒无操作自动跳过更新并启动软件，防止无人值守卡窗），支持一键下载（仅下载、不覆盖本地 config/resource 配置）",
        "note": "为保证用户获得新版本自动检测与更新弹窗，请引导用户使用 launcher.bat 而非直接双击 mxu.exe；x_ 前缀字段为扩展约定，MXU 会忽略未知字段。"
    }
}
